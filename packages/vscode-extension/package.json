{
  "name": "sf-ai-toolkit",
  "displayName": "SF AI Toolkit",
  "description": "Make every Salesforce DX project AI-ready in minutes. Scaffolds secure cross-tool workflows for Cursor, Claude, Codex-style agents, Antigravity, and MCP-powered Salesforce delivery.",
  "version": "0.1.7",
  "publisher": "NikhilKarkra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/karkranikhil/sf-ai-toolkit"
  },
  "bugs": {
    "url": "https://github.com/karkranikhil/sf-ai-toolkit/issues"
  },
  "homepage": "https://github.com/karkranikhil/sf-ai-toolkit#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#00A1E0",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "SF AI Toolkit modifies workspace files and may fetch team config over network."
    }
  },
  "categories": [
    "Other",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "salesforce",
    "salesforce dx",
    "sfdx",
    "claude",
    "cursor",
    "codex",
    "antigravity",
    "agentic",
    "ai",
    "mcp",
    "agentforce",
    "apex",
    "lwc"
  ],
  "activationEvents": [
    "workspaceContains:sfdx-project.json",
    "onCommand:ai-kit-sf.scan"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-kit-sf.scan",
        "title": "SF AI Toolkit: Scan Salesforce Project"
      },
      {
        "command": "ai-kit-sf.init",
        "title": "SF AI Toolkit: Apply Recommended Setup"
      },
      {
        "command": "ai-kit-sf.openReport",
        "title": "SF AI Toolkit: Open Readiness Report"
      },
      {
        "command": "ai-kit-sf.addCursor",
        "title": "SF AI Toolkit: Add Cursor Rules"
      },
      {
        "command": "ai-kit-sf.addCursorSkills",
        "title": "SF AI Toolkit: Add Cursor Skills"
      },
      {
        "command": "ai-kit-sf.addClaude",
        "title": "SF AI Toolkit: Add Claude Code Setup"
      },
      {
        "command": "ai-kit-sf.addMcp",
        "title": "SF AI Toolkit: Add MCP Guardrails"
      },
      {
        "command": "ai-kit-sf.addHooks",
        "title": "SF AI Toolkit: Add Git Hooks"
      },
      {
        "command": "ai-kit-sf.addAfvSkills",
        "title": "SF AI Toolkit: Add AFV Skill Templates (40)"
      },
      {
        "command": "ai-kit-sf.addAfvLibrary",
        "title": "SF AI Toolkit: Add Salesforce AFV Library Guide"
      },
      {
        "command": "ai-kit-sf.bootstrapMcp",
        "title": "SF AI Toolkit: Bootstrap MCP Config"
      },
      {
        "command": "ai-kit-sf.checkDrift",
        "title": "SF AI Toolkit: Check Template Drift"
      },
      {
        "command": "ai-kit-sf.addClaudeMem",
        "title": "SF AI Toolkit: Add claude-mem Salesforce Mode"
      },
      {
        "command": "ai-kit-sf.pickSkill",
        "title": "SF AI Toolkit: Insert Skill Reference"
      },
      {
        "command": "ai-kit-sf.checkTeamSync",
        "title": "SF AI Toolkit: Check Team Sync"
      }
    ],
    "configuration": {
      "title": "AI-Kit for Salesforce",
      "properties": {
        "sf-ai-toolkit.teamConfigUrl": {
          "type": "string",
          "default": "",
          "description": "URL to your team AI-Kit config JSON for drift detection on project open"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc && ncc build dist/extension.js -o dist/bundled -q --external vscode && node scripts/finalize-extension.mjs",
    "watch": "tsc -watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "build:tsc": "tsc"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "@sf-ai-toolkit/core": "*"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@vercel/ncc": "^0.38.4",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.5"
  },
  "author": {
    "name": "Nikhil Karkra",
    "url": "https://github.com/karkranikhil"
  }
}
